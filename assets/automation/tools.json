       "required": [
        "type",
        "code"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "shell"
         ]
        },
        "command": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "type",
        "command"
       ],
       "additionalProperties": false
      }
