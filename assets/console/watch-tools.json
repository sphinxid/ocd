        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "arguments": {
        "anyOf": [
         {
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "sessionID",
       "routingKey",
       "mode",
       "expiresAt"
      ],
      "additionalProperties": false
